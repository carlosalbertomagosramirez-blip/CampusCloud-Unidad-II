# Copia a docker/.env y SUSTITUYE las claves en tu equipo.
# Este archivo contiene solo valores de ejemplo, NUNCA contraseñas reales.

# Servicios de Unidad I (conservar los datos y volúmenes ya existentes)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CAMBIAR_POSTGRES_LOCAL
POSTGRES_DB=campuscloude
POSTGRES_VOLUME=campuscloud_postgres_data
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=CAMBIAR_PGADMIN_LOCAL
PGADMIN_VOLUME=campuscloud_pgadmin_data
ACCEPT_EULA=Y
MSSQL_SA_PASSWORD=CAMBIAR_SQLSERVER_LOCAL_123
MSSQL_PORT=14033
SQLSERVER_VOLUME=campuscloud_sqlserver_data
DOCKER_NETWORK=campus-network

# Nueva práctica de MongoDB (28018 evita chocar con el 28017 de clase)
MONGO_PORT=28018
MONGO_ROOT_USER=campuscloud_admin
MONGO_ROOT_PASSWORD=CAMBIAR_MONGODB_LOCAL
MONGO_VOLUME=campuscloud_u2_mongodb_data

# Nueva práctica de Neo4j (7475/7688 evitan chocar con 7474/7687)
NEO4J_HTTP_PORT=7475
NEO4J_BOLT_PORT=7688
NEO4J_PASSWORD=CAMBIAR_NEO4J_LOCAL
NEO4J_VOLUME=campuscloud_u2_neo4j_data

# Cassandra independiente y persistente
CASSANDRA_PORT=9042
CASSANDRA_VOLUME=campuscloud_u2_cassandra_data
